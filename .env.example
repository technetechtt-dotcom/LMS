# Public API URL (no trailing slash). Required for SPA calls unless you rely on vite default localhost.
#
# Recommended local full stack (Nest + Postgres):
#   npm run backend:prisma:migrate   # once
#   npm run backend:seed             # demo users
#   npm run dev:full                 # Vite + Nest (set VITE_API_URL to match)
#
# Legacy reference API (Express, in-memory):
#   npm run dev:lms-api
#
VITE_API_URL=http://localhost:8787

# Demo logins match backend/prisma/seed.ts (password: Password123!)
# - admin@skillforge.co.za (Admin)
# - facilitator@skillforge.co.za (Facilitator)
# - learner@skillforge.co.za (Learner)
# - assessor@skillforge.co.za (Assessor)
# - moderator@skillforge.co.za (Moderator)
# - seta@skillforge.co.za (SETA Official)
# - mentor@skillforge.co.za (Workplace Mentor)
# - qa@skillforge.co.za (QA Officer)
#
# --- REST contract (when VITE_API_URL is set) ---
# All routes below are under the base URL. JSON body unless noted.
# Authorization: Bearer <accessToken> except POST /auth/login
#
# Auth (NestJS):
#   POST /auth/login           -> { user, accessToken, refreshToken, tokenType }
#   POST /auth/refresh         -> body { refreshToken }
#   POST /auth/forgot-password -> body { email }
#   POST /auth/reset-password  -> body { token, password }
#   POST /auth/logout          -> Bearer auth; revokes all refresh tokens for the user
#   GET  /auth/me              -> User
#   POST /audit/log            -> client audit entry
#
# Learners:
#   GET    /learners?search=&status=
#   GET    /learners/:id
#   POST   /learners
#   PATCH  /learners/:id
#   POST   /learners/:id/poe-export     -> { url } or { data: { url }, success }
#
# Assessments:
#   GET    /assessments?search=&status=
#   GET    /assessments/:id               (optional embedded questions[])
#   GET    /assessments/:id/questions
#   POST   /assessments
#   PATCH  /assessments/:id
#   POST   /assessment-instances          (submission body)
#   POST   /assessment-instances/:id/moderate { decision, comments }
#   POST   /assessments/auto-grade       { responses }
#
# POE (multipart uploads use field "file" + JSON string "metadata"):
#   GET   /learners/:learnerId/poe-documents
#   POST  /learners/:learnerId/poe-documents
#   POST  /poe-documents/:documentId/verify { verifierId }
#
# Compliance:
#   GET   /compliance/documents
#   GET   /compliance/seta-submissions
#   POST  /compliance/documents          (multipart: file + metadata)
#   POST  /compliance/nlrd              { programmeId }
#   POST  /compliance/seta-export       { setaId, format }
#
# Materials:
#   GET  /materials?search=&status=
#   POST /materials                    (multipart: file + metadata)
#
# Programmes:
#   GET /programmes
#   GET /programmes/:id
#
# Messages & notifications:
#   GET    /messages
#   POST   /messages                    JSON { toId, content } or multipart with attachments
#   GET    /notifications
#   PATCH  /notifications/:id           { read: true }

# --- NestJS backend (new production-ready API) ---
# Backend path: ./backend
# Start backend: npm run dev:api
# One-time setup:
#   npm run backend:prisma:generate
#   npm run backend:prisma:migrate
#   npm run backend:seed
#
# Backend .env values (set in backend/.env):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public
# JWT_SECRET=<strong-secret>
# JWT_EXPIRES_IN=1d
# AWS_S3_BUCKET=lms-evidence

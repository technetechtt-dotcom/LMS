# Copy to backend/.env and fill in values.
# Neon: https://neon.com — see NEON.md in the repo root.

NODE_ENV=development
PORT=8787
FRONTEND_ORIGIN=http://localhost:5176,http://localhost:5177

# --- Database (Neon serverless Postgres) ---
# Pooled URL (host contains "-pooler") — use for the running API (Prisma Client).
# From Neon Console → Connect → "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require

# Direct URL (no "-pooler") — use for prisma migrate / db push only.
# From Neon Console → Connect → "Direct connection".
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require

# Local Docker Postgres (no pooler): set both to the same value, e.g.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public

JWT_SECRET=change-me-to-strong-secret-min-32-chars
FILE_SIGNING_SECRET=change-me-to-a-different-file-signing-secret
JOB_ENCRYPTION_KEY=change-me-to-a-different-job-encryption-secret
MFA_ENCRYPTION_KEY=change-me-to-a-different-mfa-encryption-secret
MFA_ISSUER=SkillForge LMS
APP_VERSION=development
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# File uploads — local development fallback only
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=25
UPLOAD_TOTAL_MAX_MB=52
UPLOAD_RETENTION_DAYS=2555

# Required to enable production uploads: private S3-compatible durable storage.
# Objects remain quarantined until the scanner returns a clean verdict.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MALWARE_SCAN_URL=
MALWARE_SCAN_HEALTH_URL=
MALWARE_SCAN_TOKEN=

# Required to enable production activation/reset mail: HTTPS delivery webhook.
MAIL_DELIVERY_URL=
MAIL_DELIVERY_HEALTH_URL=
MAIL_DELIVERY_TOKEN=
MAIL_RETRY_WORKER_ENABLED=true

# Admin maintenance routes (/users etc). Defaults to false in production.
ADMIN_ENDPOINTS_ENABLED=true

# Public self-registration (dev only). Production is invitation-only.
# PUBLIC_REGISTRATION=true

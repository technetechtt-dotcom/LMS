# Copy to backend/.env and fill in values.
# Neon: https://neon.com — see NEON.md in the repo root.

NODE_ENV=development
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (Neon serverless Postgres) ---
# Pooled URL (host contains "-pooler") — use for the running API (Prisma Client).
# From Neon Console → Connect → "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.af-south-1.aws.neon.tech/neondb?sslmode=require

# Direct URL (no "-pooler") — use for prisma migrate / db push only.
# From Neon Console → Connect → "Direct connection".
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.af-south-1.aws.neon.tech/neondb?sslmode=require

# Local Docker Postgres (no pooler): set both to the same value, e.g.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public

JWT_SECRET=change-me-to-strong-secret-min-32-chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# Optional: log reset links to console when email is not wired (dev only)
# LOG_PASSWORD_RESET_LINK=true

# Mail — production requires MAIL_PROVIDER=smtp (+ SMTP_*) or explicitly "log"
MAIL_PROVIDER=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# SMTP_SECURE=false

# File uploads — production requires real AWS_* unless FILE_STORAGE=mock
FILE_STORAGE=mock
AWS_REGION=af-south-1
AWS_S3_BUCKET=mock-bucket
AWS_ACCESS_KEY_ID=mock
AWS_SECRET_ACCESS_KEY=mock

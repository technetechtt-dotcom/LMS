# Copy to backend/.env and fill in values.
# Neon: https://neon.com — see NEON.md in the repo root.

NODE_ENV=development
PORT=8787
FRONTEND_ORIGIN=http://localhost:5176,http://localhost:5177

# --- Database (Neon serverless Postgres) ---
# Pooled URL (host contains "-pooler") — use for the running API (Prisma Client).
# From Neon Console → Connect → "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Direct URL (no "-pooler") — use for prisma migrate / db push only.
# From Neon Console → Connect → "Direct connection".
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Local Docker Postgres (no pooler): set both to the same value, e.g.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public

JWT_SECRET=change-me-to-strong-secret-min-32-chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# Optional: log reset links to console when email is not wired (dev only)
# LOG_PASSWORD_RESET_LINK=true

# Mail — production REQUIRES MAIL_PROVIDER=smtp + SMTP_HOST + SMTP_FROM
MAIL_PROVIDER=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# SMTP_SECURE=false

# File uploads — production FORBIDS FILE_STORAGE=mock; real AWS_* required
FILE_STORAGE=mock
AWS_REGION=af-south-1
AWS_S3_BUCKET=mock-bucket
AWS_ACCESS_KEY_ID=mock
AWS_SECRET_ACCESS_KEY=mock

# Antivirus: mock (dev) | off | http (+ AV_SCAN_URL)
# Production REQUIRES AV_SCAN_MODE=http and AV_SCAN_URL (fail-closed)
AV_SCAN_MODE=mock
# AV_SCAN_URL=https://av.example.com/scan

# Admin maintenance routes (/users etc). Defaults to false in production.
# ADMIN_ENDPOINTS_ENABLED=true

# Public self-registration (dev only). Production is invitation-only.
# PUBLIC_REGISTRATION=true

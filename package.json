{
  "name": "magic-patterns-vite-template",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "npx vite",
    "dev:ops": "cross-env VITE_API_URL=http://localhost:8787 VITE_AUTH_PORTAL=ops npx vite --config vite.ops.config.ts",
    "dev:api": "npm --prefix backend run start:dev",
    "dev:full": "concurrently -n lms,ops,api -c blue,magenta,green \"cross-env VITE_API_URL=http://localhost:8787 npm run dev\" \"cross-env VITE_API_URL=http://localhost:8787 VITE_AUTH_PORTAL=ops npm run dev:ops\" \"npm run dev:api\"",
    "build": "npx vite build",
    "build:ops": "cross-env VITE_AUTH_PORTAL=ops npx vite build --config vite.ops.config.ts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "preview": "npx vite preview",
    "backend:build": "npm --prefix backend run build",
    "backend:prisma:generate": "npm --prefix backend run prisma:generate",
    "backend:prisma:migrate": "npm --prefix backend run prisma:migrate",
    "backend:prisma:migrate:deploy": "npm --prefix backend run prisma:migrate:deploy",
    "backend:seed": "npm --prefix backend run seed",
    "backend:test": "npm --prefix backend test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "framer-motion": "^11.5.4",
    "jspdf": "^4.2.1",
    "lucide-react": "0.522.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7",
    "sonner": "^2.0.1",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "latest",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.51.0",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6"
  }
}
